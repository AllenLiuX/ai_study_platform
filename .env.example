# =============================================================================
# 学生学习驾驶舱 - 环境变量模板
# 复制此文件为 .env 后填入真实值。NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 日常对话与简单任务使用的模型 (低成本) — Phase 3.5 起等同 _MEDIUM,保留向后兼容
OPENAI_CHAT_MODEL_DEFAULT=gpt-4o-mini
# 关键场景使用的高质量模型 — Phase 3.5 起等同 _HIGH
OPENAI_CHAT_MODEL_PREMIUM=gpt-4o
# 向量嵌入模型 (Phase 1 RAG)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase 3.5: 5 档模型,学生可在对话里临时切换。
# 留空 = 用代码内置默认 (2026 选型,见 api/app/core/llm.py::_FALLBACK_MODELS):
#   low         gpt-5.4-mini   $0.75/$4.5     背单词、简单提问
#   medium      gpt-5.4        $2.50/$15      推荐默认,日常学习
#   high        gpt-5.5        $5/$30         旗舰,复杂讲解 / 写作精改
#   extra_high  o3             $2/$8          强推理,长链思考 (需 o3 权限)
#   max         gpt-5.5-pro    $30/$180       顶级,压轴大题 (需 5.5-pro 权限)
# 旧 OPENAI_CHAT_MODEL_DEFAULT/_PREMIUM 仍然兼容,会被当作 medium/high 的兜底。
# 想要其他组合(例如把 max 换成 o3-pro)直接改对应行:
# OPENAI_CHAT_MODEL_LOW=gpt-5.4-mini
# OPENAI_CHAT_MODEL_MEDIUM=gpt-5.4
# OPENAI_CHAT_MODEL_HIGH=gpt-5.5
# OPENAI_CHAT_MODEL_EXTRA_HIGH=o3
# OPENAI_CHAT_MODEL_MAX=gpt-5.5-pro

# -----------------------------------------------------------------------------
# Supabase
# 注册并创建项目: https://supabase.com
# 在 Project Settings > API 中获取以下三个值
# -----------------------------------------------------------------------------
# Supabase 项目 URL,形如 https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# anon (public) key - 前后端都可以用,客户端使用此 key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx
# service role key - 仅后端使用,具有绕过 RLS 的权限,严禁泄露到前端
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# 前端公开变量 (Next.js NEXT_PUBLIC_ 前缀)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# 前端调用后端的地址 (二选一)
#
# 方式 A (推荐,一键切换):NEXT_PUBLIC_API_MODE,代码里有内置 preset
#   - local  -> http://localhost:8000
#   - online -> https://aico-music.com:5443 (AWS 生产后端)
# 本地开发用 local;Vercel 部署在 Project Settings -> Env Vars 里设 online。
# 注意 NEXT_PUBLIC_* 是 build-time 注入,改完要重新 build / Vercel Redeploy。
NEXT_PUBLIC_API_MODE=local
#
# 方式 B (完全自定义 URL,会覆盖 mode):
# NEXT_PUBLIC_API_BASE_URL=https://your-custom-backend.example.com

# -----------------------------------------------------------------------------
# 后端服务
# -----------------------------------------------------------------------------
# CORS 允许的前端来源,逗号分隔
# 生产环境记得加上 Vercel 的 production URL,例:
#   http://localhost:3000,https://ai-study-platform-xi.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# (可选) CORS 正则:用于匹配 Vercel preview 这类动态子域名
# 例:^https://ai-study-platform[a-z0-9-]*\.vercel\.app$
BACKEND_CORS_ORIGIN_REGEX=

# 后端监听端口 (生产可由 systemd / docker 覆盖)
BACKEND_PORT=8000
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

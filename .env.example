# =============================================================================
# 学生学习驾驶舱 - 环境变量模板
# 复制此文件为 .env 后填入真实值。NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 日常对话与简单任务使用的模型 (低成本)
OPENAI_CHAT_MODEL_DEFAULT=gpt-4o-mini
# 关键场景使用的高质量模型 (学习报告/学习计划/复杂规划)
OPENAI_CHAT_MODEL_PREMIUM=gpt-4o
# 向量嵌入模型 (Phase 1 RAG)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Supabase
# 注册并创建项目: https://supabase.com
# 在 Project Settings > API 中获取以下三个值
# -----------------------------------------------------------------------------
# Supabase 项目 URL,形如 https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# anon (public) key - 前后端都可以用,客户端使用此 key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx
# service role key - 仅后端使用,具有绕过 RLS 的权限,严禁泄露到前端
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# 前端公开变量 (Next.js NEXT_PUBLIC_ 前缀)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# 前端调用后端 API 的地址
# - 本地开发: http://localhost:8000
# - 生产: 你后端部署的公网地址,如 https://api.yourdomain.com
# 部署到 Vercel 时,这个变量需要在 Vercel Project Settings → Environment Variables 里单独设
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 后端服务
# -----------------------------------------------------------------------------
# CORS 允许的前端来源,逗号分隔
# 生产环境记得加上 Vercel 的 production URL,例:
#   http://localhost:3000,https://ai-study-platform-xi.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# (可选) CORS 正则:用于匹配 Vercel preview 这类动态子域名
# 例:^https://ai-study-platform[a-z0-9-]*\.vercel\.app$
BACKEND_CORS_ORIGIN_REGEX=

# 后端监听端口 (生产可由 systemd / docker 覆盖)
BACKEND_PORT=8000
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
